{
  "name": "ark-usage-view",
  "version": "1.0.0",
  "description": "macOS 顶部栏查看 ARK 使用量的小组件",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac",
    "dist": "electron-builder --mac"
  },
  "keywords": [
    "ark",
    "volcengine",
    "menubar",
    "electron"
  ],
  "author": "unzoa",
  "license": "ISC",
  "dependencies": {
    "menubar": "^9.5.3"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.unzoa.arkusageview",
    "productName": "ArkUsageView",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "settings.html",
      "renderer.js",
      "assets/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    }
  }
}
